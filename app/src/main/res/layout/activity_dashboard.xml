<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_light_blue"
    android:padding="24dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_menu"
            android:layout_alignParentEnd="true"
            android:contentDescription="Menu"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MESSMATE"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark_blue"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRACK.SPLIT.CHILL"
        android:textSize="14sp"
        android:textColor="#5E7C9E"
        android:letterSpacing="0.2"
        android:layout_marginBottom="60dp"/>

    <!-- Grid Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="32dp">

            <!-- Member List -->
            <LinearLayout
                android:id="@+id/btn_member_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_members"
                    android:padding="16dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:contentDescription="Members" />
                 <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member List"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

            <!-- Meal Option -->
            <LinearLayout
                android:id="@+id/btn_meal_option"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_meal_custom"
                    android:padding="16dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:contentDescription="Meal Option" />
                 <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meal Option"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Payment History -->
            <LinearLayout
                android:id="@+id/btn_payment_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_payment"
                    android:padding="16dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:contentDescription="Payment History" />
                 <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment History"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

            <!-- Due Amount -->
            <LinearLayout
                android:id="@+id/btn_due_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_due"
                    android:padding="16dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:contentDescription="Due Amount" />
                 <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due Amount"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dashboard_border"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>